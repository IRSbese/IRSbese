# Обязательные настройки
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=/var/www/irsbese/instance/irsbese.sqlite3
UPLOAD_FOLDER=/var/www/irsbese/app/static/uploads
FLASK_DEBUG=0
COOKIE_SECURE=0
DEMO_MODE=0

# Оплата заблокирована по умолчанию до подтверждения решения заказчиком (T-008).
PAYMENTS_ENABLED=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта для восстановления пароля (необязательно для локального запуска)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
